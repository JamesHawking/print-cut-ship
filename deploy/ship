#!/usr/bin/env bash
# ship — gate, build, migrate, swap, and smoke MICRO_FACTORY on the server.
#
#   ship [api|web|all]        deploy (default: all; backend first)
#   ship rollback <api|web>   switch to the most recent release other than
#                             the one currently running, restart, re-smoke
#   ship status               deployed SHAs, service health, disk
#
# Runs as user `iq` on sidekick-agent, normally exec'd by the post-receive
# hook from the fresh checkout (/srv/iq/app/src) so the pushed revision's
# ship is always the one that runs. The hook passes the pushed SHA via
# IQ_SHA. The one welded gate: `go test ./...` in backend/ (includes the
# 1,512-case pricing goldens) runs before anything mutates.
#
# See deploy/README.md for the full runbook.
set -euo pipefail

IQ=/srv/iq
SRC=$IQ/app/src
GIT_DIR=$IQ/git/app.git
RELEASES=$IQ/releases
CURRENT=$IQ/current
ENVDIR=$IQ/env
KEEP=5

# Toolchains land outside the default PATH of a hook/ssh session.
export PATH=/usr/local/go/bin:$IQ/.bun/bin:/usr/local/bin:/usr/bin:/bin
export HOME=$IQ # keeps go/bun caches under /srv/iq regardless of caller

say() { printf '\n==> %s  [%s]\n' "$1" "$(date +%H:%M:%S)"; }
die() {
  printf 'ship: %s\n' "$1" >&2
  exit 1
}

# Read KEY=VALUE lines literally — the env files use systemd EnvironmentFile
# grammar, and bash-sourcing them would expand/execute shell metacharacters
# in secrets. No quoting, no expansion; blank lines and #comments skipped.
load_env() {
  local line k v
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in '' | \#*) continue ;; esac
    k=${line%%=*}
    v=${line#*=}
    case $k in '' | *[!A-Za-z0-9_]*)
      echo "ship: ignoring malformed env line in $1: ${line%%=*}" >&2
      continue
      ;;
    esac
    export "$k=$v"
  done <"$1"
}

sha() {
  local s
  s=${IQ_SHA:-$(git --git-dir="$GIT_DIR" rev-parse refs/heads/main)}
  printf '%s' "${s:0:12}"
}

smoke_api() {
  local i
  for i in $(seq 1 10); do
    if curl -fsS -m 3 localhost:8090/healthz >/dev/null 2>&1; then break; fi
    if [ "$i" = 10 ]; then die "smoke FAILED: /healthz never answered — run: ship rollback api"; fi
    sleep 1
  done
  curl -fsS -m 5 localhost:8090/api/v1/config >/dev/null ||
    die "smoke FAILED: /api/v1/config errored — run: ship rollback api"
  echo "api smoke ok (healthz + config)"
}

smoke_web() {
  local i
  for i in $(seq 1 15); do
    if curl -fsS -m 5 -o /dev/null localhost:3010/ 2>/dev/null; then
      echo "web smoke ok (/)"
      return
    fi
    sleep 1
  done
  die "smoke FAILED: web / never answered — run: ship rollback web"
}

flip() { # flip <side> <release-dir>  — atomic symlink swap
  ln -sfn "$2" "$CURRENT/.$1.tmp"
  mv -T "$CURRENT/.$1.tmp" "$CURRENT/$1"
}

restart() { sudo -n systemctl restart "iq-$1.service"; }

prune() { # keep newest $KEEP per side, never the one in use
  local side=$1 cur
  cur=$(readlink -f "$CURRENT/$side" 2>/dev/null || true)
  ls -1dt "$RELEASES/$side"-* 2>/dev/null | tail -n +$((KEEP + 1)) |
    while read -r d; do [ "$(readlink -f "$d")" = "$cur" ] || rm -rf "$d"; done || true
}

deploy_api() {
  local rel=$RELEASES/api-$REL_ID
  say "build api ($SHA)"
  mkdir -p "$rel"
  (cd "$SRC/backend" && nice -n10 go build -trimpath -ldflags='-s -w' -o "$rel/api" ./cmd/api)
  printf '%s  %s\n' "$SHA" "$(date -Is)" >"$rel/RELEASE"

  say "migrate + seed (new binary, old one still serving)"
  (
    load_env "$ENVDIR/api.env"
    "$rel/api" migrate
    "$rel/api" seed
  )

  say "swap + restart iq-api"
  flip api "$rel"
  restart api
  smoke_api
  prune api
}

deploy_web() {
  local rel=$RELEASES/web-$REL_ID
  say "build web ($SHA)"
  cd "$SRC/instant-quote"
  bun install --frozen-lockfile
  (
    load_env "$ENVDIR/web.build.env"
    NODE_OPTIONS=--max-old-space-size=1536 nice -n10 ionice -c2 -n7 bun run build
  )
  mkdir -p "$rel"
  cp -a .output/. "$rel/"
  printf '%s  %s\n' "$SHA" "$(date -Is)" >"$rel/RELEASE"

  say "swap + restart iq-web"
  flip web "$rel"
  restart web
  smoke_web
  prune web
}

cmd_status() {
  echo "main (bare repo): $(git --git-dir="$GIT_DIR" rev-parse --short=12 refs/heads/main 2>/dev/null || echo '-')"
  for side in api web; do
    printf '%-4s current: %s  (%s)\n' "$side" \
      "$(basename "$(readlink "$CURRENT/$side" 2>/dev/null || echo none)")" \
      "$(systemctl is-active "iq-$side.service" 2>/dev/null || true)"
  done
  curl -fsS -m 3 localhost:8090/healthz >/dev/null 2>&1 && echo "healthz: ok" || echo "healthz: FAIL"
  df -h / | tail -1 | awk '{print "disk /: "$3" used / "$2" ("$5")"}'
}

cmd_rollback() {
  local side=${1:-} cur prev
  [ "$side" = api ] || [ "$side" = web ] || die "usage: ship rollback <api|web>"
  cur=$(readlink -f "$CURRENT/$side" 2>/dev/null || true)
  prev=$(ls -1dt "$RELEASES/$side"-* 2>/dev/null | while read -r d; do
    [ "$(readlink -f "$d")" = "$cur" ] || {
      echo "$d"
      break
    }
  done || true)
  [ -n "$prev" ] || die "no other $side release to roll back to"
  say "rollback $side -> $(basename "$prev")"
  flip "$side" "$prev"
  restart "$side"
  [ "$side" = api ] && smoke_api || smoke_web
}

main() {
  local target=${1:-all}

  case $target in
  status)
    cmd_status
    exit 0
    ;;
  rollback)
    shift
    cmd_rollback "${1:-}"
    exit 0
    ;;
  api | web | all) ;;
  *) die "usage: ship [api|web|all] | ship rollback <api|web> | ship status" ;;
  esac

  exec 9>"$IQ/.ship.lock"
  flock -n 9 || die "another ship is in progress"

  SHA=$(sha)
  # Release dirs are unique per DEPLOY, not per SHA: a same-SHA redeploy
  # (e.g. domain day's env-only rebuild) must never delete or overwrite the
  # release the live symlink points at.
  REL_ID=$SHA-$(date +%Y%m%d%H%M%S)
  mkdir -p "$IQ/log"
  LOG=$IQ/log/ship-$(date +%Y%m%d-%H%M%S)-$SHA.log
  exec > >(tee -a "$LOG") 2>&1
  say "ship $target @ $SHA"

  say "gate: go test ./... (pricing goldens included)"
  (cd "$SRC/backend" && nice -n10 go test ./...) ||
    die "GATE FAILED — production untouched"

  case $target in
  api) deploy_api ;;
  web) deploy_web ;;
  all)
    deploy_api
    deploy_web
    ;;
  esac

  say "done: $target @ $SHA is live"
}

main "$@"
