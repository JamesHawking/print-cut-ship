# /srv/iq/env/api.env — production runtime env for iq-api (systemd
# EnvironmentFile; also sourced by ship for migrate/seed and by deploy/dev,
# which overrides everything stateful).
#
# PLACEHOLDERS ONLY in the repo copy. bootstrap.sh copies this to
# /srv/iq/env/api.env (0600 iq:iq) once; fill real values there, never here.
# EnvironmentFile is not a shell: plain KEY=value lines, no quoting needed.

PORT=8090

# Coolify-managed Postgres 16, published on host port 5433. Database `app`.
# Keep the `/app?` shape — deploy/dev textually rewrites it to /app_dev?.
DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:5433/app?sslmode=disable

# S3/MinIO. One scheme for BOTH endpoints — storage.go builds the internal
# and presign clients from the same S3_USE_SSL flag — and it must match the
# page scheme, or the browser blocks presigned PUTs as mixed content.
# Preview phase (no domain, plain http through Traefik):
S3_ENDPOINT=s3-iq.37-27-84-96.sslip.io
S3_PUBLIC_ENDPOINT=s3-iq.37-27-84-96.sslip.io
S3_USE_SSL=false
# Domain day: both endpoints -> s3.<domain>, S3_USE_SSL=true.
# Garage validates the SigV4 region (its garage.toml s3_region).
S3_REGION=garage
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=instantquote

# Frontend origin used in provider redirect URLs.
# Domain day: https://<domain>, and COOKIE_SECURE=true.
PUBLIC_BASE_URL=http://iq.37-27-84-96.sslip.io
COOKIE_SECURE=false

# The only provider until plan 18 wires Stripe. The stub checkout route is
# unreachable from the public internet — Traefik ipAllowList pins
# /api/v1/payments/stub/* to the tailnet (deploy/traefik/iq.dynamic.yaml).
PAYMENTS_PROVIDER=stub

# Empty -> emails render into journald (journalctl -u iq-api) instead of
# sending. Wire after the domain exists: plans/engineering/runbooks/email-dns.md
RESEND_API_KEY=
EMAIL_FROM_ORDERS=orders@example.com
EMAIL_FROM_AUTH=no-reply@example.com
EMAIL_REPLY_TO=support@example.com
EMAIL_SUPPORT=support@example.com

# Optional — MakerWorld import degrades gracefully without it (~90-day expiry).
BAMBU_CLOUD_TOKEN=

# SESSION_TTL_DAYS / LOGIN_CODE_TTL_MINUTES / FILE_RETENTION_UNORDERED_DAYS:
# defaults (30 / 10 / 30) are fine — deliberately not set here.
