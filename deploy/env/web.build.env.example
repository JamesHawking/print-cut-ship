# /srv/iq/env/web.build.env — BUILD-time env for the web bundle. ship
# sources this before `bun run build`; every value is baked into the output,
# so changing any of them requires a `ship web` rebuild.
#
# PLACEHOLDERS ONLY in the repo copy. bootstrap.sh copies this to
# /srv/iq/env/web.build.env (0600 iq:iq) once; fill real values there.

# Canonical public origin (SEO canonicals, sitemap, og:url).
# Domain day: https://<domain>
VITE_SITE_URL=http://iq.37-27-84-96.sslip.io

VITE_SUPPORT_EMAIL=support@example.com

# SSR-side /api fallback proxy target, baked into the Nitro server. The
# Traefik edge normally owns /api routing; this covers SSR-internal calls.
API_PROXY=http://127.0.0.1:8090
